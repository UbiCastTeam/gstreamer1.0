#!/usr/bin/make -f

include /usr/share/dpkg/default.mk
include /usr/share/dpkg/pkg-info.mk

export HOME=$(CURDIR)/fake-home

# upstream version
gst_version=$(shell echo $(DEB_VERSION) | cut -d '-' -f 1)

CFLAGS += -Wno-error
CXXFLAGS += -Wno-error

# UbiCast custom conf — debhelper default option cannot be overriden in init
# file so they shall be here (like `wrap-mode`)
conf_flags += --native-file ../ubicast/ubicast.ini --wrap-mode=default

# --buildsystem=meson is needed here (as we have a custom Makefile that mask the
#  real meson build system)
%:
	dh $@ --buildsystem=meson

# Drop the libexecdir override when we're not in a Freeze?
# May need rebuilds or code changes to other packages to adapt
override_dh_auto_configure:
	dh_auto_configure -- $(conf_flags)

# Only make the tests fail for key architectures
override_dh_auto_test:

# ifneq (,$(filter $(DEB_HOST_ARCH), amd64 arm64))
# 	dh_auto_test
# else
# 	dh_auto_test || true
# endif

override_dh_makeshlibs:
	dh_makeshlibs -pgstreamer-full1.0 -X "/usr/lib/$(DEB_HOST_MULTIARCH)/gstreamer-1.0" -V 'gstreamer-full1.0 (>= $(gst_version))' -- -c0 -Odebian/gstreamer-full1.0.symbols
